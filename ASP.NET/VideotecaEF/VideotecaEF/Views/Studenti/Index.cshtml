@model IEnumerable<VideotecaEF.Models.Studente>

@{
    ViewData["Title"] = "Elenco Studenti";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<p>
    <form>
        Ricerca: <input type="text" name="searchText" value="@ViewBag.SearchText" />
        <input type="hidden" name="recordsPerPage" value="@ViewBag.RecordsPerPage" />
        <input type="submit" value="Cerca" />
    </form>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cognome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Classe)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cognome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Classe)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Matricola" class="btn btn-sm btn-primary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Matricola" class="btn btn-sm btn-secondary">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Matricola" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<form>
    <p>
        Elementi per pagina:
        <select name="recordsPerPage" onchange="this.form.submit()">
            @foreach (int n in new[] { 20, 50, 100, 0 } )
                {
                <option value="@n" selected="@(n == (int?)ViewBag.RecordsPerPage)" >@(n != 0 ? n : "Tutti")</option>
                }
        </select>
        <input type="hidden" name="searchText" value="@ViewBag.SearchText" />
    </p>
</form>

<p>
    @for (int i = 1; i <= (int)ViewData["pages"]; i++)
    {
        <a href="/Studenti?page=@i&recordsPerPage=@ViewBag.RecordsPerPage&searchText=@ViewBag.SearchText">@i</a>
    }
</p>
