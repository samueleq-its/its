@model IEnumerable<GAM.Models.OperaViewModel>

@{
    ViewData["Title"] = "Elenco Opere";
}

    <h1>Elenco Opere</h1>

        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Immagine</th>
                    <th scope="col">Inventario</th>
                    <th scope="col">Titolo</th>
                    <th scope="col">Autore</th>
                    <th scope="col">Datazione</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Immagine"</td>
                            <td>@item.Inventario</td>
                            <td>@item.Titolo</td>
                            <td>@item.Autore</td>
                            <td>@item.Datazione</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td>Nessuna opera trovata.</td>
                    </tr>
                }
            </tbody>
        </table>
