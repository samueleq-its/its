@model BikeStores.Data.Models.Order

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Order</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OrderDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OrderDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RequiredDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RequiredDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ShippedDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ShippedDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Customer)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Customer.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OrderStatus)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OrderStatus.IdStatus)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Staff)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Staff.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Store)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Store.StoreName)
        </dd>
    </dl>

    <h4>Products</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Product</th><th>Quantity</th><th>List price</th><th>Discount</th>
                <th>Total price</th><th>Discount total</th><th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.OrderItems)
        {
            var totalPrice = item.Quantity * item.ListPrice;
            var discountTotal = totalPrice * item.Discount;
            <tr>
                <td>@item.Product.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.ListPrice.ToString("C")</td>
                <td>@item.Discount.ToString("P")</td>
                <td>@totalPrice.ToString("C")</td>
                <td>@discountTotal.ToString("C")</td>
                <td>@((totalPrice - discountTotal).ToString("C"))</td>
            </tr>
        }
        </tbody>
    </table>
    <h4>Total order price: @Model.OrderItems.Sum(item => item.Quantity * item.ListPrice * (1 - item.Discount)).ToString("C")</h4>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.OrderId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
