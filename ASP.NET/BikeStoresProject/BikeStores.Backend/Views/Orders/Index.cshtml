@model IEnumerable<BikeStores.Data.Models.Order>

@{
    ViewData["Title"] = "Index";
}

<h1>Orders</h1>

<form method="get" class="mb-3">
    <input name="searchText" value="@ViewBag.SearchText" placeholder="Search..." />
    <select name="statusId">
        <option value="">All states</option>
        @foreach (var status in ViewBag.Statuses)
        {
            <option value="@status.IdStatus" selected="@(ViewBag.StatusId == status.IdStatus)">@status.StatusName</option>
        }
    </select>
    <select name="orderBy">
        <option value="date" selected="@(ViewBag.OrderBy == "date")">Date</option>
        <option value="customer" selected="@(ViewBag.OrderBy == "customer")">Customer</option>
        <option value="status" selected="@(ViewBag.OrderBy == "status")">State</option>
    </select>
    <input type="hidden" name="pageSize" value="@ViewBag.PageSize" />
    <button type="submit" class="btn btn-sm btn-primary">Search</button>
</form>
@if (User.IsInRole("ADMINISTRATOR") || User.IsInRole("EMPLOYEES"))
{
    <p><a asp-action="Create" class="btn btn-sm btn-primary">Create New</a></p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequiredDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ShippedDate)
            </th>
            <th>
                Customer
            </th>
            <th>
                State
            </th>
            <th>
                Staff
            </th>
            <th>
                Store
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RequiredDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ShippedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderStatus.StatusName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Staff.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Store.StoreName)
            </td>
            <td>
                @if (User.IsInRole("ADMINISTRATOR") || User.IsInRole("EMPLOYEES"))
                {
                    <a asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.OrderId" class="btn btn-sm btn-danger">Delete</a>
                }
                <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-secondary">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>
<nav>
    @for (var pageNumber = 1; pageNumber <= (int)ViewBag.TotalPages; pageNumber++)
    {
        <a class="btn btn-sm @(pageNumber == (int)ViewBag.Page ? "btn-primary" : "btn-secondary")"
           asp-route-page="@pageNumber" asp-route-pageSize="@ViewBag.PageSize"
           asp-route-searchText="@ViewBag.SearchText" asp-route-statusId="@ViewBag.StatusId"
           asp-route-orderBy="@ViewBag.OrderBy">@pageNumber</a>
    }
</nav>
